QWidget {
    background-color: #151517;
    color: #f5f6f7;
    font-family: "Ubuntu", "Segoe UI", sans-serif;
}

QLineEdit, QTextEdit {
    background-color: #1b1b1c;
    border: 1px solid #5d6062;
    border-radius: 8px;
    padding: 8px 12px;
    color: #f5f6f7;
    selection-background-color: #5686fe;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #5686fe;
}

QPushButton {
    background-color: #5686fe;
    color: #f5f6f7;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover   { background-color: #3f6ad8; }
QPushButton:pressed { background-color: #2f4fa8; }
QPushButton:disabled { background-color: #3a3a3c; color: #7a7d80; }

QListWidget {
    background-color: #2c2c2e;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 8px 12px;
    margin: 1px 2px;
    border-radius: 6px;
}

QListWidget::item:hover    { background-color: #35353a; }
QListWidget::item:selected { background-color: #5686fe; color: #f5f6f7; }

QScrollBar:vertical {
    background: #1b1b1c;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #3f4144;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover { background: #5d6062; }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QStatusBar {
    background-color: #2c2c2e;
    color: #f5f6f7;
    border-top: 1px solid #1b1b1c;
}

QSplitter::handle {
    background-color: #1b1b1c;
}

QSplitter::handle:hover {
    background-color: #5686fe;
}

QToolTip {
    background-color: #2c2c2e;
    color: #f5f6f7;
    border: 1px solid #5d6062;
    border-radius: 4px;
    padding: 4px 8px;
}