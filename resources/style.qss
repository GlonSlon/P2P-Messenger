QWidget {
    background-color: #151517;
    color: #f5f6f7;
    font-family: "Ubuntu", "Segoe UI", sans-serif;
}

QLineEdit, QTextEdit {
    background-color: #1b1b1c;
    border: 1px solid #5d6062;
    border-radius: 6px;
    padding: 6px;
    color: #f5f6f7;
    selection-background-color: #5686fe;
}

QPushButton {
    background-color: #5686fe;
    color: #f5f6f7;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover { background-color: #3f6ad8; }
QListWidget { background-color: #2c2c2e; border: none; outline: none; }
QListWidget::item:selected { background-color: #5686fe; color: #f5f6f7; }
QScrollBar:vertical { background: #1b1b1c; width: 8px; }
QScrollBar::handle:vertical { background: #5d6062; border-radius: 4px; }
QStatusBar { background-color: #2c2c2e; color: #f5f6f7; }
